# Copy this file to .env (same folder) and fill in. .env is gitignored.
# Any real environment variable overrides the value here.

REGULA_LLM_BASE_URL=https://openrouter.ai/api/v1
REGULA_LLM_MODEL=z-ai/glm-5.3-flash
REGULA_LLM_API_KEY=

# Scheduled document sync (discovery + ingest). Five-field cron, server-local
# time, e.g. */30 * * * * or 0 9 * * 1-5. Empty or "off" = manual only.
REGULA_SYNC_CRON=
REGULA_SYNC_LIMIT=3
